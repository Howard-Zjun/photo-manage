<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pers.howard.personalspace.dao.PreferenceDao">

    <update id="updatePrefer" parameterType="pers.howard.personalspace.model.PreferenceItem">
        update perference
        <set>
            <if test="environment != null">environment = #{environment}</if>
            <if test="fontSize != null">font_size = #{fontSize}</if>
        </set>
        <where>
            user_id = #{userID}
        </where>
    </update>

    <select id="retrievePrefer" resultType="pers.howard.personalspace.model.PreferenceItem">
        select *
        from perference where user_id = #{userID};
    </select>
</mapper>
