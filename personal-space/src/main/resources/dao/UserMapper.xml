<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="pers.howard.personalspace.dao.UserDao">

    <select id="retrieveBasic" resultType="pers.howard.personalspace.model.PersonItem">
        select *
        from user where user_id = #{userID};
    </select>

    <update id="updateBasic" parameterType="pers.howard.personalspace.model.PersonItem">
        update user
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="sex != null">sex = #{sex},</if>
            <if test="address != null">address = #{address},</if>
            <if test="birth != null">birth = #{birth},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="introduction != null">introduction = #{introduction}</if>
        </set>
        <where>
            user_id = #{userID}
        </where>
    </update>

    <select id="retrievePasswordAtEmail" resultType="java.lang.String">
        select password from user where email = #{email}
    </select>

    <select id="retrieveRowAtEmail" resultType="int">
        select count(*) from user where email = #{email}
    </select>

    <insert id="insertUser">
        insert into user (name, password, email)
        values (#{item.name}, #{item.password}, #{item.email})
    </insert>

    <select id="retrieveUserIdAtEmail" resultType="java.lang.Integer">
        select user_id from user where email = #{email}
    </select>
</mapper>
